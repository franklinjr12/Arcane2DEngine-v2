# Generates a C++ file with the contents of schemas/*.schema.json as byte arrays (no string-literal
# length limits, so MSVC accepts it). Usage: embed_schemas(<out.cpp> <schemas dir>)
function(embed_schemas OUT SCHEMA_DIR)
  file(GLOB FILES ${SCHEMA_DIR}/*.schema.json)
  list(SORT FILES)
  set(BODY "// Generated by cmake/embed_schemas.cmake. Do not edit.\n#include \"arcane_tooling/offline.hpp\"\n\nnamespace arcane::tooling {\nnamespace {\n")
  set(TABLE "")
  set(INDEX 0)
  foreach(FILE ${FILES})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${FILE})
    get_filename_component(NAME ${FILE} NAME)
    string(REPLACE ".schema.json" "" NAME ${NAME})
    file(READ ${FILE} HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    string(APPEND BODY "const unsigned char kSchema${INDEX}[] = {${BYTES}};\n")
    string(APPEND TABLE "      {\"${NAME}\", std::string_view(reinterpret_cast<const char*>(kSchema${INDEX}), sizeof kSchema${INDEX})},\n")
    math(EXPR INDEX "${INDEX}+1")
  endforeach()
  string(APPEND BODY "}  // namespace\n\nconst std::vector<EmbeddedSchema>& embedded_schemas() {\n  static const std::vector<EmbeddedSchema> schemas = {\n${TABLE}  };\n  return schemas;\n}\n\n}  // namespace arcane::tooling\n")
  file(WRITE ${OUT}.tmp "${BODY}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
endfunction()
