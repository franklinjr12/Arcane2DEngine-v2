{
  "$defs": {
    "override": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string"
        },
        "local_id": {
          "minimum": 1,
          "type": "integer"
        },
        "property": {
          "type": "string"
        },
        "value": {
          "description": "Encoded like the property it overrides (see docs/formats/scene.md); the type comes from the prefab node's component descriptor or the node field."
        }
      },
      "required": [
        "local_id",
        "property",
        "value"
      ],
      "type": "object"
    },
    "vec2": {
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "$id": "https://arcane2d.local/schemas/arcane.scene.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arcane.scene"
    },
    "next_id": {
      "minimum": 1,
      "type": "integer"
    },
    "nodes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minimum": 1,
                  "type": "integer"
                },
                "properties": {
                  "description": "Names and value types are defined by the component type's registered descriptors (builtin or game module); validate them with the module-aware validator.",
                  "type": "object"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "minimum": 0,
            "type": "integer"
          },
          "position": {
            "$ref": "#/$defs/vec2"
          },
          "prefab": {
            "additionalProperties": false,
            "description": "Marks the node as part of a prefab instance (docs/formats/prefab.md). overrides appear only on the instance root (instance_id == node id).",
            "properties": {
              "asset": {
                "description": "Project-relative path of the *.prefab.json file.",
                "type": "string"
              },
              "instance_id": {
                "minimum": 1,
                "type": "integer"
              },
              "local_id": {
                "minimum": 1,
                "type": "integer"
              },
              "overrides": {
                "items": {
                  "$ref": "#/$defs/override"
                },
                "type": "array"
              }
            },
            "required": [
              "asset",
              "instance_id",
              "local_id"
            ],
            "type": "object"
          },
          "rotation_radians": {
            "type": "number"
          },
          "scale": {
            "$ref": "#/$defs/vec2"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 2
    }
  },
  "required": [
    "format",
    "version",
    "nodes"
  ],
  "title": "Arcane scene file (v2)",
  "type": "object"
}
