{
  "$id": "https://arcane2d.local/schemas/arcane.save.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_version": {
      "minimum": 1,
      "type": "integer"
    },
    "format": {
      "const": "arcane.save"
    },
    "values": {
      "additionalProperties": {
        "type": [
          "boolean",
          "integer",
          "number",
          "string"
        ]
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
      },
      "type": "object"
    },
    "version": {
      "const": 2
    }
  },
  "required": [
    "format",
    "version"
  ],
  "title": "Arcane save game (v2)",
  "type": "object"
}
