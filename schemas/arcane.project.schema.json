{
  "$defs": {
    "project_path": {
      "pattern": "^(?!/)(?![A-Za-z]:)([^/\\\\]+)(/[^/\\\\]+)*$",
      "type": "string"
    }
  },
  "$id": "https://arcane2d.local/schemas/arcane.project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collision_layers": {
      "items": {
        "pattern": "^[a-z0-9_]{1,32}$",
        "type": "string"
      },
      "maxItems": 31,
      "type": "array"
    },
    "debug": {
      "additionalProperties": false,
      "properties": {
        "overlay_font_scale": {
          "exclusiveMinimum": 0,
          "maximum": 8,
          "type": "number"
        },
        "overlay_visible": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "format": {
      "const": "arcane.project"
    },
    "hud": {
      "type": "object"
    },
    "input_actions": {
      "type": "object"
    },
    "main_scene": {
      "$ref": "#/$defs/project_path"
    },
    "module": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/project_path"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "save": {
      "additionalProperties": false,
      "properties": {
        "data_version": {
          "minimum": 1,
          "type": "integer"
        },
        "game_id": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "type": "string"
            }
          ]
        }
      },
      "type": "object"
    },
    "transition": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "fade_in_seconds": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        "fade_out_seconds": {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "version": {
      "const": 2
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "main_scene"
  ],
  "title": "Arcane project file (v2)",
  "type": "object"
}
